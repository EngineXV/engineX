# Log Monitor — copy to .env and fill in values

# Required for production (--require-live)
GRAFANA_URL=https://grafana.example.com
GRAFANA_API_TOKEN=
GRAFANA_DATASOURCE_UID=

# Alerting
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Optional ticketing
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# LLM (triage + dispatch nodes)
ANTHROPIC_API_KEY=

# Tuning
LOG_MONITOR_KEYWORDS=error,exception,fatal,panic
LOG_MONITOR_LOOKBACK_MINUTES=1
LOG_MONITOR_MUTE_MINUTES=30
LOG_MONITOR_ALERT_COOLDOWN_MINUTES=15

# Dev only
# LOG_MONITOR_ALLOW_MOCK=1
