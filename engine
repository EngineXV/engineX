#!/usr/bin/env bash
#
# Wrapper script for the Engine CLI.
# Uses uv to run the engine command in the project's virtual environment.
#
# Usage:
#   ./engine run <agent>   - Run an agent
#   ./engine open          - Open web dashboard
#   ./engine --help        - Show all commands
#

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

USER_CWD="$(pwd)"
if [ "$USER_CWD" != "$SCRIPT_DIR" ]; then
    echo "Error: engine must be run from the project directory." >&2
    echo "" >&2
    echo "  Current directory: $USER_CWD" >&2
    echo "  Expected directory: $SCRIPT_DIR" >&2
    echo "" >&2
    echo "Run: cd $SCRIPT_DIR" >&2
    exit 1
fi

cd "$SCRIPT_DIR"

if [ ! -f "$SCRIPT_DIR/pyproject.toml" ] || [ ! -d "$SCRIPT_DIR/core" ]; then
    echo "Error: Not a valid Engine project directory: $SCRIPT_DIR" >&2
    exit 1
fi

if [ ! -d "$SCRIPT_DIR/.venv" ]; then
    echo "Error: Virtual environment not found. Run ./quickstart.sh first." >&2
    exit 1
fi

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

if ! command -v uv &> /dev/null; then
    echo "Error: uv is not installed. Run ./quickstart.sh first." >&2
    exit 1
fi

exec uv run engine "$@"
